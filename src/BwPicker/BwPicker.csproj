<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      One codebase, two builds: Windows (default) and Linux (`-r linux-x64`, or -p:TargetOS=linux). Shared code lives in the
      usual folders; Platform/Windows and Platform/Linux hold each platform's services (hotkey, typing, clipboard, tray, autostart).
    -->
    <TargetOS Condition="'$(TargetOS)' == '' and $(RuntimeIdentifier.StartsWith('linux'))">linux</TargetOS>
    <TargetOS Condition="'$(TargetOS)' == ''">windows</TargetOS>
    <TargetFramework Condition="'$(TargetOS)' == 'windows'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(TargetOS)' == 'linux'">net10.0</TargetFramework>
    <DefineConstants Condition="'$(TargetOS)' == 'linux'">$(DefineConstants);LINUX</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BwPicker</AssemblyName>
    <RootNamespace>BwPicker</RootNamespace>
    <!-- Local builds are "-dev" and never auto-update; release CI passes -p:Version from the git tag. -->
    <Version>0.0.0-dev</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetOS)' == 'windows'">
    <ApplicationIcon>assets\bw-picker.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <NativeLibraryExtension>.dll</NativeLibraryExtension>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetOS)' == 'linux'">
    <NativeLibraryExtension>.so</NativeLibraryExtension>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetOS)' == 'windows'">
    <Compile Remove="Platform\Linux\**" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetOS)' == 'linux'">
    <Compile Remove="Platform\Windows\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.12" Condition="'$(TargetOS)' == 'windows'" />
    <!-- Linux: desktop notifications and lock/sleep events over DBus (the same library Avalonia uses). -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.1" Condition="'$(TargetOS)' == 'linux'" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\bw-picker.ico" LogicalName="BwPicker.AppIcon.ico" />
    <InternalsVisibleTo Include="BwPicker.Tests" />
  </ItemGroup>

  <!--
    Release builds (with a runtime identifier) embed the native libraries Avalonia needs, so the exe can restore or
    verify the copies next to it at startup (see NativeLibraries.cs). This keeps updates from older versions, whose
    updater only replaced BwPicker.exe, working.
  -->
  <Target Name="EmbedNativeLibraries" BeforeTargets="AssignTargetPaths;PrepareResourceNames" DependsOnTargets="ResolvePackageAssets"
          Condition="'$(RuntimeIdentifier)' != ''">
    <ItemGroup>
      <EmbeddedResource Include="@(NativeCopyLocalItems->WithMetadataValue('Extension', '$(NativeLibraryExtension)'))" LogicalName="native/%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>

</Project>
